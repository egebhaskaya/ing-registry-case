{
  "uid": "registration-case",
  "title": "Registration Case",
  "description": "Registration case: compare publisher-confirmed 202 intake with synchronous 201 commits and 200 replays. Select one Registry target (8080 regular, 8082 benchmark). Shared services remain global. Scrape/refresh 5s; rates 30s; latency/recovery 1m. Counters reset on restart; database counts are authoritative.",
  "tags": [
    "registration-case"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 3,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "registry_instance",
        "label": "Registry target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=~\"registry|registry-benchmark\"}, instance)",
        "query": {
          "query": "label_values(up{job=~\"registry|registry-benchmark\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "regex": "",
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {
          "selected": true,
          "text": "host.docker.internal:8080",
          "value": "host.docker.internal:8080"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "At a glance · selected Registry and shared services",
