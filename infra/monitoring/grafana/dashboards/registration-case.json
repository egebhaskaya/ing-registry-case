    {
      "id": 100,
      "type": "stat",
      "title": "Scrape availability",
      "description": "Prometheus can scrape these endpoints. This is telemetry availability, not proof that a business transaction will succeed. Registry follows the selected target; Compliance and RabbitMQ are shared by both Registry targets.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=~\"registry|registry-benchmark\",instance=\"$registry_instance\"})",
          "legendFormat": "Registry",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "min(up{job=\"compliance\"})",
          "legendFormat": "Compliance",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "min(up{job=\"rabbitmq\"})",
          "legendFormat": "RabbitMQ",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "noValue": "no data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
