          "expr": "sum(rate(registry_intake_requests_total{application=\"registry-service\",instance=\"$registry_instance\",outcome=\"accepted\"}[30s]))",
          "legendFormat": "async accepted/s",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(rate(registry_sync_requests_total{application=\"registry-service\",instance=\"$registry_instance\",outcome=\"created\"}[30s]))",
          "legendFormat": "sync created/s",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "sum(rate(registry_registrations_total{application=\"registry-service\",instance=\"$registry_instance\",outcome=\"created\"}[30s]))",
