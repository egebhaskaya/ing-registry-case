    {
      "id": 103,
      "type": "timeseries",
      "title": "Synchronous HTTP outcomes /s",
      "description": "POST /registrations/sync. 201 = new Registry commit, 200 = same-key replay, 409 = conflict, 503 = refused capacity. Input errors and other server errors are shown separately. Each series appears after that status has been observed; 30s rates smooth brief bursts.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"registry-service\",instance=\"$registry_instance\",uri=\"/registrations/sync\",method=\"POST\",status=\"201\"}[30s]))",
          "legendFormat": "201 created",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"registry-service\",instance=\"$registry_instance\",uri=\"/registrations/sync\",method=\"POST\",status=\"200\"}[30s]))",
          "legendFormat": "200 replayed",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"registry-service\",instance=\"$registry_instance\",uri=\"/registrations/sync\",method=\"POST\",status=\"409\"}[30s]))",
          "legendFormat": "409 conflict",
          "instant": false
        },
        {
          "refId": "D",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"registry-service\",instance=\"$registry_instance\",uri=\"/registrations/sync\",method=\"POST\",status=\"503\"}[30s]))",
          "legendFormat": "503 overloaded",
          "instant": false
        },
        {
          "refId": "E",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"registry-service\",instance=\"$registry_instance\",uri=\"/registrations/sync\",method=\"POST\",status=\"400\"}[30s]))",
          "legendFormat": "400 invalid input",
          "instant": false
        },
        {
          "refId": "F",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"registry-service\",instance=\"$registry_instance\",uri=\"/registrations/sync\",method=\"POST\",status=~\"5..\",status!=\"503\"}[30s]))",
          "legendFormat": "other 5xx",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "Queued intake decisions /s",
      "description": "POST /registrations returns 202 after confirmed routing to RabbitMQ; it does not promise a user commit. Other intake outcomes are 503 reasons, including an unknown confirmation outcome that must be retried with the same key.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(registry_intake_requests_total{application=\"registry-service\",instance=\"$registry_instance\"}[30s]))",
          "legendFormat": "{{outcome}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Observed progress · process counters",
      "description": "Accepted = async 202 receipts. Sync created = successful synchronous creations. Registry committed includes both routes, while Compliance is a shared service and can include work from other Registry targets. Counters reset on restart and are not a common cohort or a database ledger. No subtraction is used to infer backlog.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(registry_intake_requests_total{application=\"registry-service\",instance=\"$registry_instance\",outcome=\"accepted\"})",
          "legendFormat": "async accepted (202)",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(registry_sync_requests_total{application=\"registry-service\",instance=\"$registry_instance\",outcome=\"created\"})",
          "legendFormat": "sync created (201)",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "sum(registry_registrations_total{application=\"registry-service\",instance=\"$registry_instance\",outcome=\"created\"})",
          "legendFormat": "Registry committed · both routes",
          "instant": false
        },
        {
          "refId": "D",
          "expr": "sum(compliance_events_total{application=\"compliance-service\",instance=\"host.docker.internal:8081\",outcome=\"processed\"})",
          "legendFormat": "Compliance results · shared service",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
