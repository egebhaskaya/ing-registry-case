    {
      "id": 107,
      "type": "timeseries",
      "title": "Shared execution and HTTP waiting",
      "description": "Active executions hold a processing permit through commit and duplicate resolution; they can include executions waiting for a database connection. HTTP waiters are outside those executions and have a bounded count and admission wait. Rabbit waits for permits without rejecting already accepted commands.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "registry_processing_active{application=\"registry-service\",instance=\"$registry_instance\"}",
          "legendFormat": "executions holding permits",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "registry_processing_waiting_requests{application=\"registry-service\",instance=\"$registry_instance\"}",
          "legendFormat": "HTTP requests waiting for permits",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "registry_config_processing_concurrency{application=\"registry-service\",instance=\"$registry_instance\"}",
          "legendFormat": "execution limit",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false,
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "execution limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Registry database pool",
      "description": "Active = checked-out connections; pending = executions waiting for a connection; idle = reusable connections. Pending is connection contention, not proof of database CPU saturation. With 16 execution permits and a pool of four, up to twelve permitted executions can wait here.",
      "gridPos": {
