{
  "uid": "registration-case",
  "title": "Registration Case",
  "description": "One shared RabbitMQ pipeline for async and sync registrations. Five-second samples; throughput is averaged over 30 seconds and p95 is estimated from histogram buckets over one minute. Progress and error counters belong to each service process and reset independently on restart.",
  "tags": [
    "registration-case"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 4,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Configuration",
      "description": "The Registry consumes both async and sync requests from the same RabbitMQ queue. Prefetch limits unacknowledged deliveries per consumer. The pool maximum caps Registry database connections. Virtual threads reports the Registry thread mode. Compliance has at most four useful consumers for its four partitions.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(registry_config_consumers{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry consumers",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "(max(registry_config_prefetch{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Prefetch / consumer",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "(sum(hikaricp_connections_max{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry pool max",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "(max(registry_threads_virtual_enabled{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Virtual threads",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "(max(compliance_config_concurrency{job=\"compliance\",application=\"compliance-service\"})) and on() (max(up{job=\"compliance\"}) == 1)",
          "legendFormat": "Compliance consumers",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "No data",
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Virtual threads"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OFF"
                      },
                      "1": {
                        "text": "ON"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Throughput",
      "description": "Events per second averaged over 30 seconds. HTTP successes include async 202 receipts and sync 201 creations or 200 replays. Registry creations count committed new users; Compliance checks count committed results. These stages can finish at different times.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(http_server_requests_seconds_count{job=\"registry\",application=\"registry-service\",uri=~\"/registrations(/sync)?\",method=\"POST\",status=~\"200|201|202\"}[30s]))) or on() vector(0)) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "HTTP successes",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "((sum(rate(registry_registrations_total{job=\"registry\",application=\"registry-service\",outcome=\"created\"}[30s]))) or on() vector(0)) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry creations",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "((sum(rate(compliance_events_total{job=\"compliance\",application=\"compliance-service\",outcome=\"processed\"}[30s]))) or on() vector(0)) and on() (max(up{job=\"compliance\"}) == 1)",
          "legendFormat": "Compliance checks",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 3,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RabbitMQ queue",
      "description": "Messages in the shared registration.commands queue. Ready messages wait at the broker. Unacknowledged includes work being processed and prefetched deliveries waiting at consumers. The queue is drained when both reach zero.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rabbitmq_queue_messages_ready{job=\"rabbitmq\",queue=\"registration.commands\"})) or on() vector(0)) and on() (max(up{job=\"rabbitmq\"}) == 1)",
          "legendFormat": "Ready at broker",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "((sum(rabbitmq_queue_messages_unacked{job=\"rabbitmq\",queue=\"registration.commands\"})) or on() vector(0)) and on() (max(up{job=\"rabbitmq\"}) == 1)",
          "legendFormat": "Unacknowledged",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 3,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Registry database pool",
      "description": "Connections sampled every five seconds. Active connections are borrowed by transactions; pending callers wait for a connection. Short waits between samples may be missed. More consumers do not increase the pool maximum.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(hikaricp_connections_active{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Active connections",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "(sum(hikaricp_connections_max{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Pool maximum",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "(sum(hikaricp_connections_pending{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Waiting for connection",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 3,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pool maximum"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 response and completion time",
      "description": "Time is measured in seconds; small values display as milliseconds. HTTP async ends after broker confirmation. HTTP sync includes waiting for the Registry commit reply. Registry completion includes queue waiting through user/outbox commit. Compliance completion covers the full pipeline. These are histogram estimates over one minute; no observations means no latency value.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"registry\",application=\"registry-service\",uri=\"/registrations\",method=\"POST\",status=\"202\"}[1m])))) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "HTTP async (202)",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"registry\",application=\"registry-service\",uri=\"/registrations/sync\",method=\"POST\",status=~\"200|201\"}[1m])))) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "HTTP sync (200/201)",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(registry_registration_completion_seconds_bucket{job=\"registry\",application=\"registry-service\"}[1m])))) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry completion",
          "instant": false
        },
        {
          "refId": "D",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(compliance_completion_seconds_bucket{job=\"compliance\",application=\"compliance-service\"}[1m])))) and on() (max(up{job=\"compliance\"}) == 1)",
          "legendFormat": "Compliance completion",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 3,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Progress since each service started",
      "description": "Current process counters, not totals for the selected time range or an exact per-run ledger. Registry and Compliance reset independently on restart. HTTP successes include replay responses, so the values need not match. An absent counter is zero only while its service is being scraped successfully; unavailable telemetry remains No data.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(http_server_requests_seconds_count{job=\"registry\",application=\"registry-service\",uri=~\"/registrations(/sync)?\",method=\"POST\",status=~\"200|201|202\"})) or on() vector(0)) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "HTTP successes",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "((sum(registry_registrations_total{job=\"registry\",application=\"registry-service\",outcome=\"created\"})) or on() vector(0)) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry creations",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "((sum(compliance_events_total{job=\"compliance\",application=\"compliance-service\",outcome=\"processed\"})) or on() vector(0)) and on() (max(up{job=\"compliance\"}) == 1)",
          "legendFormat": "Compliance checks",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "No data",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Errors since each service started",
      "description": "HTTP 4xx/5xx includes validation errors, conflicts and 503 responses; a timeout can have an unknown outcome. Failed attempts can be retried. Dead-letter values count publishes by the current Registry/Compliance process, not queue depth. Counters reset independently. An absent counter is zero only while its service is UP; missing telemetry remains No data.",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(http_server_requests_seconds_count{job=\"registry\",application=\"registry-service\",uri=~\"/registrations(/sync)?\",method=\"POST\",status=~\"[45]..\"})) or on() vector(0)) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "HTTP 4xx/5xx",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "((sum(registry_registrations_failures_total{job=\"registry\",application=\"registry-service\"})) or on() vector(0)) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry failed attempts",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "((sum(registry_registrations_dead_lettered_total{job=\"registry\",application=\"registry-service\"})) or on() vector(0)) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry dead letters",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "((sum(compliance_events_dead_lettered_total{job=\"compliance\",application=\"compliance-service\"})) or on() vector(0)) and on() (max(up{job=\"compliance\"}) == 1)",
          "legendFormat": "Compliance dead letters",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "No data",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      }
    }
  ]
}
