    {
      "id": 105,
      "type": "timeseries",
      "title": "HTTP p95 · successful responses versus all responses",
      "description": "Histogram p95 over 1m windows. Sync success includes 201 and 200; async success is 202. All-response latency also includes potentially fast rejections, so it can look better while successful registrations are slow. 200ms admission waiting is not a whole-request deadline.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"registry-service\",instance=\"$registry_instance\",uri=\"/registrations/sync\",method=\"POST\",status=~\"200|201\"}[1m])))",
          "legendFormat": "sync 201/200 p95 · committed",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"registry-service\",instance=\"$registry_instance\",uri=\"/registrations/sync\",method=\"POST\"}[1m])))",
          "legendFormat": "sync all responses p95",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"registry-service\",instance=\"$registry_instance\",uri=\"/registrations\",method=\"POST\",status=\"202\"}[1m])))",
          "legendFormat": "async 202 p95 · accepted",
          "instant": false
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"registry-service\",instance=\"$registry_instance\",uri=\"/registrations\",method=\"POST\"}[1m])))",
          "legendFormat": "async all responses p95",
          "instant": false
        }
      ],
