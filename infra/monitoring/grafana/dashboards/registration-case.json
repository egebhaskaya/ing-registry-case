        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Stage throughput /s",
      "description": "30s rates of real milestones. Queue acceptance and Registry commit have different boundaries. Compliance is shared across Registry targets. Use successful commit throughput together with rejection counts and latency.",
