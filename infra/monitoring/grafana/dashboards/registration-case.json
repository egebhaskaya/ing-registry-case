{
  "uid": "registration-case",
  "title": "Registration Case",
  "description": "One shared RabbitMQ pipeline for async and sync registrations. One-second samples and refresh; server decision and processing rates use 10-second windows. Histogram p95 estimates use 30-second windows, with HTTP on the right millisecond axis and completion on the left second axis. Lifetime counters reset independently on each service restart.",
  "tags": [
    "registration-case"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1s",
  "schemaVersion": 39,
  "version": 6,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Configuration and current activity",
      "description": "Configured limits are not measured busy workers. Both HTTP routes use the same Registry consumers. Prefetch limits unacknowledged deliveries per consumer; the pool maximum caps Registry database connections. Virtual threads reports Registry thread mode. Useful Compliance concurrency is limited by the event topic's actual partition count. Compliance busy now is measured work in progress, including database waiting, and can remain nonzero after Registry has finished.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(registry_config_consumers{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry consumers",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "(max(registry_config_prefetch{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Prefetch / consumer",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "(sum(hikaricp_connections_max{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry pool max",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "(max(registry_threads_virtual_enabled{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Virtual threads",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "(max(compliance_config_concurrency{job=\"compliance\",application=\"compliance-service\"})) and on() (max(up{job=\"compliance\"}) == 1)",
          "legendFormat": "Compliance consumers",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "(sum(compliance_workers_active{job=\"compliance\",application=\"compliance-service\"})) and on() (max(up{job=\"compliance\"}) == 1)",
          "legendFormat": "Compliance busy now",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "No data",
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Virtual threads"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OFF"
                      },
                      "1": {
                        "text": "ON"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server decisions and processing /s",
      "description": "Ten-second rate estimates from application counters sampled every second, not exact k6 burst throughput. Async accepted decisions follow broker confirmation. Sync completed decisions follow a committed worker result and include replays. Registry creations and Compliance checks count new committed results. These stages can finish at different times.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(registry_intake_requests_total{job=\"registry\",application=\"registry-service\",outcome=\"accepted\"}[10s]))) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Async accepted decisions",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "(sum(rate(registry_sync_requests_total{job=\"registry\",application=\"registry-service\",outcome=~\"created|replayed\"}[10s]))) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Sync completed decisions",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "(sum(rate(registry_registrations_total{job=\"registry\",application=\"registry-service\",outcome=\"created\"}[10s]))) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry creations",
          "instant": false
        },
        {
          "refId": "D",
          "expr": "(sum(rate(compliance_events_total{job=\"compliance\",application=\"compliance-service\",outcome=\"processed\"}[10s]))) and on() (max(up{job=\"compliance\"}) == 1)",
          "legendFormat": "Compliance checks",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 3,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1s"
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RabbitMQ queue",
      "description": "Sampled messages in the shared registration.commands queue. Ready messages wait at the broker. Unacknowledged includes processing and prefetched deliveries waiting at consumers, so it is not a busy-worker count. Both must reach zero to drain. Missing queue metrics remain a gap rather than an invented zero. Legend maxima are observed samples and can miss shorter peaks.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rabbitmq_queue_messages_ready{job=\"rabbitmq\",queue=\"registration.commands\"})) and on() (max(up{job=\"rabbitmq\"}) == 1)",
          "legendFormat": "Ready at broker",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "(sum(rabbitmq_queue_messages_unacked{job=\"rabbitmq\",queue=\"registration.commands\"})) and on() (max(up{job=\"rabbitmq\"}) == 1)",
          "legendFormat": "Unacknowledged",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 3,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1s"
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Registry workers and database pool",
      "description": "One-second samples. Workers in progress are executing a command, including time waiting for a database connection. Active connections are borrowed from Hikari; pending callers wait for one. Compare measured workers with connections to see the pool limit. Counts are not CPU parallelism. Short activity between samples can still be missed.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(registry_workers_active{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Workers in progress (includes waiting)",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "(sum(hikaricp_connections_active{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Active DB connections",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "(sum(hikaricp_connections_pending{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Waiting for DB connection",
          "instant": false
        },
        {
          "refId": "D",
          "expr": "(sum(hikaricp_connections_max{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Pool maximum",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 3,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pool maximum"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1s"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 HTTP response and pipeline completion",
      "description": "Thirty-second histogram estimates. Left axis: Registry and Compliance completion in seconds, including queue waiting. Right axis: successful HTTP response time in milliseconds; async ends after broker confirmation and sync after the Registry commit reply. The axes have different scales. Empty observation windows remain gaps. Estimates can blend nearby runs and differ from exact per-run k6 response measurements.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"registry\",application=\"registry-service\",uri=\"/registrations\",method=\"POST\",status=\"202\"}[30s])))) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "HTTP async (202)",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "(1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"registry\",application=\"registry-service\",uri=\"/registrations/sync\",method=\"POST\",status=~\"200|201\"}[30s])))) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "HTTP sync (200/201)",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(registry_registration_completion_seconds_bucket{job=\"registry\",application=\"registry-service\"}[30s])))) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry completion",
          "instant": false
        },
        {
          "refId": "D",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(compliance_completion_seconds_bucket{job=\"compliance\",application=\"compliance-service\"}[30s])))) and on() (max(up{job=\"compliance\"}) == 1)",
          "legendFormat": "Compliance completion",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 3,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false,
            "axisPlacement": "left",
            "axisLabel": "Completion (seconds)"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "HTTP async (202)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "HTTP response (milliseconds)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HTTP sync (200/201)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "HTTP response (milliseconds)"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1s"
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Progress since each service started",
      "description": "Application decision and result counters since each service process started, not totals for the selected range or an exact per-run ledger. Async accepted and sync completed are server decisions; sync includes replay responses. Registry creations count new users, while Compliance checks count new results. Services reset independently on restart, so these values need not match. Use the HTML k6 report for a specific run.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(registry_intake_requests_total{job=\"registry\",application=\"registry-service\",outcome=\"accepted\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Async accepted",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "(sum(registry_sync_requests_total{job=\"registry\",application=\"registry-service\",outcome=~\"created|replayed\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Sync completed",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "(sum(registry_registrations_total{job=\"registry\",application=\"registry-service\",outcome=\"created\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry creations",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "(sum(compliance_events_total{job=\"compliance\",application=\"compliance-service\",outcome=\"processed\"})) and on() (max(up{job=\"compliance\"}) == 1)",
          "legendFormat": "Compliance checks",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "No data",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Errors since each service started",
      "description": "Counters since each service started. HTTP 4xx/5xx includes validation errors, conflicts and 503 responses; a timeout can have an unknown outcome. Failed attempts can be retried. Dead-letter values count publishes, not current queue depth. Services reset independently. An absent HTTP error counter is zero only while Registry is UP; unavailable telemetry remains No data.",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(http_server_requests_seconds_count{job=\"registry\",application=\"registry-service\",uri=~\"/registrations(/sync)?\",method=\"POST\",status=~\"[45]..\"})) or on() vector(0)) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "HTTP 4xx/5xx",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "(sum(registry_registrations_failures_total{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry failed attempts",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "(sum(registry_registrations_dead_lettered_total{job=\"registry\",application=\"registry-service\"})) and on() (max(up{job=\"registry\"}) == 1)",
          "legendFormat": "Registry dead letters",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "(sum(compliance_events_dead_lettered_total{job=\"compliance\",application=\"compliance-service\"})) and on() (max(up{job=\"compliance\"}) == 1)",
          "legendFormat": "Compliance dead letters",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "No data",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      }
    }
  ],
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  }
}
